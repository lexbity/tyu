.claude
.tools
devdocs/
fuzz/corpus/
target

*.bak
*.o
.tyu-verify/

# Lean port build artifacts (verification/ports/*/lakefile target outputs)
verification/ports/*/.lake/
verification/ports/*/lake-manifest.json

# Harvest-fixture build artifacts (the P7.1 gate regenerates everything
# fresh each run — committed artifacts are a stale trap when the port's
# Harvest.lean/Sound.lean/etc. change)
verification/ports/*/tests/*/.lake/
verification/ports/*/tests/*/lake-manifest.json
verification/ports/*/tests/*/lean-toolchain

# The browser REPL's build artifacts (PLAN-WASM-1 P5): generated by
# `ci/wasm.sh` (build-web) — the wasm cdylib via wasm-bindgen, the packed
# `tyu-sysroot/1` blob, and the SHA-256-pinned manifest the page boots
# against. Never hand-edited; G55 regenerates and re-verifies them.
web/pkg/
web/test/node_modules/

# The editor stack's build intermediates (PLAN-WASM-2 W2): the generated
# Lezer parser + terms (rebuilt by `node web/editor/build.mjs`; the vendor
# bundle under web/pkg/vendor/ is covered by the web/pkg/ rule above).
web/editor/lang-tyu/src/parser.js
web/editor/lang-tyu/src/parser.terms.js
web/editor/node_modules/
