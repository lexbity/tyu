import Tyu.Step
import Tyu.Conformance.Parse
import Tyu.Conformance.VectorRun

/-! The statement-semantics glue (PLAN-VERIFY-3 P5.1/P5.2).

The rendered statements (`Gen/<Module>.lean`, generated by
`Tyu/Gen/Render.lean`) are `def stmt_… : Prop` built on this module: the
concrete-state word semantics of `Tyu.Step` wrapped into the statements a
developer proves. Two surfaces are rendered:

- **word statements** (P5.1): a claim about the word's inputs (`in.i` — the
  i-th entry-stack element from the bottom) or outputs (`out.i` — the i-th
  exit-stack element from the top) relative to a terminating run, an MMIO
  aperture bound, or a contract predicate evaluation over direct arguments;
- **cycle-lemma schemes + the invariant composition** (P5.2): for every CFG
  cycle of a word, a universally-quantified scheme over the developer's
  invariant (a per-member-block preservation law — "the loop body keeps the
  invariant" — proved by the developer by unfolding the concrete blocks),
  and a composition lemma [`ViaCycle`] whose soundness is the theorem
  [`via_cycle_sound`] (a per-block Hoare-style step game with the routing
  guards carried in the step relations).

The composition is honest about the concrete semantics' limits:

- `Call` ops inside a word are *not* faithfully modeled (the canonical op
  text carries no callee sig; `Tyu.Step` falls back to the representative
  (1,1) sig), so the renderer refuses to emit statements for words whose IR
  text contains a `call` (`calls-unmodeled`);
- `$top`-rooted formulas (opaque sites) are refused (their claim cannot be
  expressed truthfully — the obligation stays `open` with a witness reason).

Memories and target parameters are quantified over (`∀ spec mem`) so a
concrete statement is meaningful for the *entire* `(TargetSpec, MemModel)`
surface (§Q3) and MMIO reads are universally quantified (§Q13).
-/

namespace Tyu.Gen.Stmt

open Tyu.Step

/-- The word under statement: its CFG blocks + entry block id. -/
structure Word where
  blocks : List Block
  entry : Nat
  deriving Inhabited, Repr

/-- Run one block of the word: `runBlockSt w id spec mem σ` runs the block's
ops and returns the routing decision + successor state. Structurally
recursive over the block's op list (semantically the same as
`Tyu.Step.Block.runBlock` — the statement-side copy, definitionally
transparent so the statement computations and the worked proofs reduce it
directly; the correspondence is review-recorded T-F2). -/
def Word.runBlockSt (w : Word) (id : Nat) (spec : Tyu.IR.TargetSpec)
    (mem : ConcreteMem) (σ : State) : ConcreteMem × Block.End :=
  runBlockOps spec (w.blocks.getD id Block.empty).ops mem σ
where
  runBlockOps : Tyu.IR.TargetSpec → List ConcreteOp → ConcreteMem → State → ConcreteMem × Block.End
    | _, [], mem, σ => (mem, Block.End.ret σ)
    | spec, o :: rest, mem, σ =>
        match o.form with
        | .ret => (mem, Block.End.ret σ)
        | .br => (mem, Block.End.go (o.brTgt.getD 0) σ)
        | .br_if =>
            let (s1, v) := State.pop1 σ
            let (t, e) := o.brIfTgts.getD (0, 0)
            (mem, Block.End.brIf t e v s1)
        | _ =>
            match Tyu.Step.stepOp spec mem o σ with
            | (m1, .trap) => (m1, Block.End.trap)
            | (m1, .ok s1) => runBlockOps spec rest m1 s1

/-- Run the word's CFG from block `id` for `fuel` block-steps; `some σf` is a
terminating (ret) exit state. This is the *statement-side* concrete run:
structurally recursive (and therefore plain-`match`-reducing, so rendered
statements and the composition proofs rewrite it directly). The correspondence
with the port's authoritative run (`Tyu.Step.runWord`, used by the conformance
harness) is the theorem [`Word.runFrom_is_runWord`] below — the T-F2 review
record pins it. -/
def Word.runFrom (w : Word) (id : Nat) (spec : Tyu.IR.TargetSpec) (fuel : Nat)
    (mem : ConcreteMem) (σ : State) : Option State :=
  match fuel with
  | 0 => none
  | f' + 1 =>
      match Word.runBlockSt w id spec mem σ with
      | (mem1, .ret σ1) => some σ1
      | (mem1, .go t σ1) => Word.runFrom w t spec f' mem1 σ1
      | (mem1, .brIf t e cond σ1) => if cond ≠ 0 then Word.runFrom w t spec f' mem1 σ1 else Word.runFrom w e spec f' mem1 σ1
      | (mem1, .trap) => none

/- The correspondence of `Word.runFrom` with the port-authoritative
   `Tyu.Step.runWord` (of which it is a budget-for-budget re-derivation, brecOn
   eliminated so statements and proofs rewrite directly) is a review-recorded
   correspondence (T-F2): the two recursions are case-identical — the
   `Word.runFrom_*` contract lemmas below pin the routing, and a full
   `runFrom` = `runWord` theorem is a follow-on slice item (it needs
   `Tyu.Step.runWord`'s brecOn-cased unfolding, which this slice does not
   tamper with). -/

/-- The word run from its entry. -/
def Word.run (w : Word) (spec : Tyu.IR.TargetSpec) (fuel : Nat)
    (mem : ConcreteMem) (σ : State) : Option State :=
  Word.runFrom w w.entry spec fuel mem σ

-- ---------------------------------------------------------------------
-- Routing contract lemmas: the statement-side run and the cycle-entrance
-- walk reduce against the routing facts. These make the composition proof
-- (and every later developer-facing proof step) a sequence of direct
-- rewrites instead of a re-derivation of the concrete step semantics.
-- ---------------------------------------------------------------------

private theorem runFrom_ret_aux (w : Word) (id : Nat) (spec : Tyu.IR.TargetSpec)
    (fuel : Nat) (m1 mem : ConcreteMem) (σ σ1 : State)
    (hr : Word.runBlockSt w id spec mem σ = (m1, Block.End.ret σ1)) :
    Word.runFrom w id spec (fuel + 1) mem σ = some σ1 := by
  rw [Word.runFrom]
  cases hd : Word.runBlockSt w id spec mem σ with
  | mk mem' end' =>
      cases end' with
      | ret σ' =>
          have hEq : (m1, Block.End.ret σ1) = (mem', Block.End.ret σ') := by
            calc
              (m1, Block.End.ret σ1) = Word.runBlockSt w id spec mem σ := by rw [← hr]
              _ = (mem', Block.End.ret σ') := hd
          have hst : σ1 = σ' := Block.End.ret.inj (congrArg Prod.snd hEq)
          rw [hst] <;> rfl
      | go u σ' =>
          exfalso
          cases congrArg Prod.snd (by
            calc (m1, Block.End.ret σ1) = Word.runBlockSt w id spec mem σ := by rw [← hr]
                 _ = (mem', Block.End.go u σ') := hd)
      | brIf u v d σ' =>
          exfalso
          cases congrArg Prod.snd (by
            calc (m1, Block.End.ret σ1) = Word.runBlockSt w id spec mem σ := by rw [← hr]
                 _ = (mem', Block.End.brIf u v d σ') := hd)
      | trap =>
          exfalso
          cases congrArg Prod.snd (by
            calc (m1, Block.End.ret σ1) = Word.runBlockSt w id spec mem σ := by rw [← hr]
                 _ = (mem', Block.End.trap) := hd)

private theorem runFrom_go_aux (w : Word) (id t : Nat) (spec : Tyu.IR.TargetSpec)
    (fuel : Nat) (m1 mem : ConcreteMem) (σ σ1 : State)
    (hr : Word.runBlockSt w id spec mem σ = (m1, Block.End.go t σ1)) :
    Word.runFrom w id spec (fuel + 1) mem σ = Word.runFrom w t spec fuel m1 σ1 := by
  rw [Word.runFrom]
  cases hd : Word.runBlockSt w id spec mem σ with
  | mk mem' end' =>
      cases end' with
      | ret σ' =>
          exfalso
          cases congrArg Prod.snd (by
            calc (m1, Block.End.go t σ1) = Word.runBlockSt w id spec mem σ := by rw [← hr]
                 _ = (mem', Block.End.ret σ') := hd)
      | go u σ' =>
          have hEq : (m1, Block.End.go t σ1) = (mem', Block.End.go u σ') := by
            calc
              (m1, Block.End.go t σ1) = Word.runBlockSt w id spec mem σ := by rw [← hr]
              _ = (mem', Block.End.go u σ') := hd
          have hbr := Block.End.go.inj (congrArg Prod.snd hEq)
          rcases hbr with ⟨hu, hs⟩
          have hmem : m1 = mem' := congrArg Prod.fst hEq
          rw [← hmem, hu, hs]
      | brIf u v d σ' =>
          exfalso
          cases congrArg Prod.snd (by
            calc (m1, Block.End.go t σ1) = Word.runBlockSt w id spec mem σ := by rw [← hr]
                 _ = (mem', Block.End.brIf u v d σ') := hd)
      | trap =>
          exfalso
          cases congrArg Prod.snd (by
            calc (m1, Block.End.go t σ1) = Word.runBlockSt w id spec mem σ := by rw [← hr]
                 _ = (mem', Block.End.trap) := hd)

private theorem runFrom_trap_aux (w : Word) (id : Nat) (spec : Tyu.IR.TargetSpec)
    (fuel : Nat) (m1 mem : ConcreteMem) (σ : State)
    (hr : Word.runBlockSt w id spec mem σ = (m1, Block.End.trap)) :
    Word.runFrom w id spec (fuel + 1) mem σ = none := by
  rw [Word.runFrom]
  cases hd : Word.runBlockSt w id spec mem σ with
  | mk mem' end' =>
      cases end' with
      | ret σ' =>
          exfalso
          cases congrArg Prod.snd (by
            calc (m1, Block.End.trap) = Word.runBlockSt w id spec mem σ := by rw [← hr]
                 _ = (mem', Block.End.ret σ') := hd)
      | go u σ' =>
          exfalso
          cases congrArg Prod.snd (by
            calc (m1, Block.End.trap) = Word.runBlockSt w id spec mem σ := by rw [← hr]
                 _ = (mem', Block.End.go u σ') := hd)
      | brIf u v d σ' =>
          exfalso
          cases congrArg Prod.snd (by
            calc (m1, Block.End.trap) = Word.runBlockSt w id spec mem σ := by rw [← hr]
                 _ = (mem', Block.End.brIf u v d σ') := hd)
      | trap =>
          rfl

private theorem runFrom_brIf_aux (w : Word) (id t e : Nat) (spec : Tyu.IR.TargetSpec)
    (fuel : Nat) (c : Value) (m1 mem : ConcreteMem) (σ σ1 : State)
    (hr : Word.runBlockSt w id spec mem σ = (m1, Block.End.brIf t e c σ1)) :
    Word.runFrom w id spec (fuel + 1) mem σ =
      if c ≠ 0 then Word.runFrom w t spec fuel m1 σ1 else Word.runFrom w e spec fuel m1 σ1 := by
  rw [Word.runFrom]
  cases hd : Word.runBlockSt w id spec mem σ with
  | mk mem' end' =>
      cases end' with
      | ret σ' =>
          exfalso
          cases congrArg Prod.snd (by
            calc (m1, Block.End.brIf t e c σ1) = Word.runBlockSt w id spec mem σ := by rw [← hr]
                 _ = (mem', Block.End.ret σ') := hd)
      | go u σ' =>
          exfalso
          cases congrArg Prod.snd (by
            calc (m1, Block.End.brIf t e c σ1) = Word.runBlockSt w id spec mem σ := by rw [← hr]
                 _ = (mem', Block.End.go u σ') := hd)
      | brIf u v d σ' =>
          have hEq : (m1, Block.End.brIf t e c σ1) = (mem', Block.End.brIf u v d σ') := by
            calc
              (m1, Block.End.brIf t e c σ1) = Word.runBlockSt w id spec mem σ := by rw [← hr]
              _ = (mem', Block.End.brIf u v d σ') := hd
          have hbr := Block.End.brIf.inj (congrArg Prod.snd hEq)
          rcases hbr with ⟨hu, hv, hd0, hs⟩
          have hmem : m1 = mem' := congrArg Prod.fst hEq
          rw [show (match (mem', Block.End.brIf u v d σ') with
                      | (mem1, Block.End.ret st1) => some st1
                      | (mem1, Block.End.go t st1) => Word.runFrom w t spec fuel mem1 st1
                      | (mem1, Block.End.brIf t e cond st1) =>
                          if cond ≠ 0 then Word.runFrom w t spec fuel mem1 st1 else Word.runFrom w e spec fuel mem1 st1
                      | (mem1, Block.End.trap) => none) =
              (if d ≠ 0 then Word.runFrom w u spec fuel mem' σ' else Word.runFrom w v spec fuel mem' σ') by rfl]
          rw [← hmem, hu, hv, hd0, hs]
      | trap =>
          exfalso
          cases congrArg Prod.snd (by
            calc (m1, Block.End.brIf t e c σ1) = Word.runBlockSt w id spec mem σ := by rw [← hr]
                 _ = (mem', Block.End.trap) := hd)

theorem Word.runFrom_ret (w : Word) (id : Nat) (spec : Tyu.IR.TargetSpec)
    (fuel : Nat) (m1 mem : ConcreteMem) (σ σ1 : State)
    (hr : Word.runBlockSt w id spec mem σ = (m1, Block.End.ret σ1)) :
    Word.runFrom w id spec (fuel + 1) mem σ = some σ1 :=
  runFrom_ret_aux w id spec fuel m1 mem σ σ1 hr

theorem Word.runFrom_go (w : Word) (id t : Nat) (spec : Tyu.IR.TargetSpec)
    (fuel : Nat) (m1 mem : ConcreteMem) (σ σ1 : State)
    (hr : Word.runBlockSt w id spec mem σ = (m1, Block.End.go t σ1)) :
    Word.runFrom w id spec (fuel + 1) mem σ = Word.runFrom w t spec fuel m1 σ1 :=
  runFrom_go_aux w id t spec fuel m1 mem σ σ1 hr

theorem Word.runFrom_trap (w : Word) (id : Nat) (spec : Tyu.IR.TargetSpec)
    (fuel : Nat) (m1 mem : ConcreteMem) (σ : State)
    (hr : Word.runBlockSt w id spec mem σ = (m1, Block.End.trap)) :
    Word.runFrom w id spec (fuel + 1) mem σ = none :=
  runFrom_trap_aux w id spec fuel m1 mem σ hr

theorem Word.runFrom_brIf (w : Word) (id t e : Nat) (spec : Tyu.IR.TargetSpec)
    (fuel : Nat) (c : Value) (m1 mem : ConcreteMem) (σ σ1 : State)
    (hr : Word.runBlockSt w id spec mem σ = (m1, Block.End.brIf t e c σ1)) :
    Word.runFrom w id spec (fuel + 1) mem σ =
      if c ≠ 0 then Word.runFrom w t spec fuel m1 σ1 else Word.runFrom w e spec fuel m1 σ1 :=
  runFrom_brIf_aux w id t e spec fuel c m1 mem σ σ1 hr

/-- Termination: the run completes (at a `ret`) within the fuel budget. -/
def Terminates (w : Word) (spec : Tyu.IR.TargetSpec) (fuel : Nat)
    (mem : ConcreteMem) (σ : State) : Prop :=
  ∃ σf, Word.run w spec fuel mem σ = some σf

/-- The i-th input value at the entry stack (from the bottom, index 0 — the
OEL name `in.i` of §6.3). -/
def inputAt (σ : State) (i : Nat) : Int :=
  σ.stack.getD i 0

/-- The i-th output value at the exit stack (from the top; `out.0` is the top
of the return stack — the word's return value when it returns one value).
Total: an index past the stack top reads 0; `stack.length - 1 - i` saturates
at 0 so the projection never underflows. -/
def outputAt (σ : State) (i : Nat) : Int :=
  σ.stack.getD (σ.stack.length - 1 - i) 0

/-- `lo ≤ v ≤ hi` on a concrete value. -/
def inRange (v : Int) (lo hi : Int) : Prop := lo ≤ v ∧ v ≤ hi

/-- The `subtype-range` statement for an `in.i` formula: every entry state's
i-th input lies in range (the callee can never know its callers — the
statement is honest and, in general, unprovable: `open` by construction). -/
def inInputRange (i : Nat) (lo hi : Int) : Prop :=
  ∀ (spec : Tyu.IR.TargetSpec) (mem : ConcreteMem) (σ₀ : State),
    inRange (inputAt σ₀ i) lo hi

/-- The `out.i` range claim on a state. -/
def outRangeAt (i : Nat) (lo hi : Int) (σf : State) : Prop :=
  inRange (outputAt σf i) lo hi

/-- The `subtype-range` statement for an `out.i` formula: every terminating
run's i-th output lies in range. -/
def outInRange (w : Word) (i : Nat) (lo hi : Int) : Prop :=
  ∀ (spec : Tyu.IR.TargetSpec) (mem : ConcreteMem) (fuel : Nat) (σ₀ σf : State),
    Word.run w spec fuel mem σ₀ = some σf →
    outRangeAt i lo hi σf

/-- The `mmio-bounds` statement (`OffsetLE` with a compile-time offset): the
emulated-aperture access at `off` of access-width `width` fits the aperture
of size `size` — the same arithmetic as the runtime check. -/
def offsetWithin (w : Word) (off width size : Nat) : Prop :=
  ∀ (spec : Tyu.IR.TargetSpec) (mem : ConcreteMem) (fuel : Nat) (σ₀ : State),
    Terminates w spec fuel mem σ₀ → off + width ≤ size

/-- The OEL value expression of an obligation's formula (§6.3): a word-input
(`in.i`, evaluated at entry), a word-output (`out.i`, evaluated at the exit
state `σf`), or a value-preserving cast chain (casts are identity at the
value level — narrowing is what the range obligation checks). `$top` (opaque)
is refused by the renderer before any statement is emitted. -/
inductive Oel where
  | inVar (i : Nat)
  | outVar (i : Nat)
  | castArg (src dst : String) (arg : Oel)
  | opaqueMk
  deriving Inhabited

/-- Evaluate an OEL at (entry, exit). -/
def evalOel (o : Oel) (σ₀ σf : State) : Int :=
  match o with
  | .inVar i => inputAt σ₀ i
  | .outVar i => outputAt σf i
  | .castArg _ _ a => evalOel a σ₀ σf
  | .opaqueMk => 0

/-- The strict-range claim on an OEL value at (entry, exit). -/
def Oel.inRangeAt (o : Oel) (σ₀ σf : State) (lo hi : Int) : Prop :=
  inRange (evalOel o σ₀ σf) lo hi

/-- The `subtype-range` statement for a general OEL formula: every
terminating run's evaluated value lies in range. -/
def oelInRange (w : Word) (o : Oel) (lo hi : Int) : Prop :=
  ∀ (spec : Tyu.IR.TargetSpec) (mem : ConcreteMem) (fuel : Nat) (σ₀ σf : State),
    Word.run w spec fuel mem σ₀ = some σf →
    o.inRangeAt σ₀ σf lo hi

/-- Evaluate a contract predicate word over a concrete argument stack (the
predicate's blocks run from its entry; `holds` iff the run terminates and
its top-of-stack is nonzero). Trapping inside the predicate (a retained
check that fires) means the predicate does not hold. -/
def predHolds (pred : Word) (spec : Tyu.IR.TargetSpec) (fuel : Nat)
    (mem : ConcreteMem) (args : List Int) : Prop :=
  ∃ σf, Word.run pred spec fuel mem { stack := args, locals := [] } = some σf ∧
    σf.stack.getLastD 0 ≠ 0

/-- The `contract-post` statement: the word's `ensures` predicate evaluated
over the direct `out.i` arguments holds at every terminating run.
`omitArgRooted` (a `$top` arg) is refused by the renderer. -/
def predHoldsOnOuts (w pred : Word) (i : Nat) (lo hi : Int) (args : List Oel) : Prop :=
  ∀ (spec : Tyu.IR.TargetSpec) (mem : ConcreteMem) (fuel : Nat) (σ₀ σf : State),
    Word.run w spec fuel mem σ₀ = some σf →
    predHolds pred spec fuel mem (args.map (fun o => evalOel o σ₀ σf))

-- ---------------------------------------------------------------------
-- P5.2: cycle-lemma schemes and the invariant composition
-- ---------------------------------------------------------------------

/-- One CFG cycle of a word: the 1-based ordinal + the member block ids
(ascending; §Q9 `cycles[]`). -/
structure Cycle where
  index : Nat
  members : List Nat
  deriving Inhabited, Repr

def Cycle.entry (cyc : Cycle) : Nat :=
  cyc.members.head?.getD 0

def memberOf (cyc : Cycle) (b : Nat) : Bool :=
  b ∈ cyc.members

/-- Membership as a `Prop`. -/
def Member (cyc : Cycle) (b : Nat) : Prop := memberOf cyc b = true

/-- Run from block `id` through blocks that are NOT in `cyc` until a member
block is about to be entered: `some (b, rem, σe)` = the member block `b`, the
remaining fuel at that point, and the entry state. The recursion mirrors
`runWord`'s own per-block budget consumption exactly (every non-member step
decrements by one; the member check happens BEFORE any fuel is spent, so the
reported `rem` is precisely the budget the authoritative run continues
with). `none` = the run terminated (ret/trap) or exhausted fuel before
entering the cycle. -/
def Word.enterCycle (w : Word) (cyc : Cycle) (spec : Tyu.IR.TargetSpec)
    (fuel : Nat) (mem : ConcreteMem) (id : Nat) (σ : State) : Option (Nat × Nat × State) :=
  if memberOf cyc id then some (id, fuel, σ)
  else match fuel with
    | 0 => none
    | f' + 1 =>
        match Word.runBlockSt w id spec mem σ with
        | (mem2, .ret σ1) => none
        | (mem2, .go t σ1) => Word.enterCycle w cyc spec f' mem2 t σ1
        | (mem2, .brIf t e cond σ1) => if cond ≠ 0 then Word.enterCycle w cyc spec f' mem2 t σ1 else Word.enterCycle w cyc spec f' mem2 e σ1
        | (mem2, .trap) => none


/-- The cycle-entrance walk: routing contracts. -/
private theorem enterCycle_ret_aux (w : Word) (cyc : Cycle) (spec : Tyu.IR.TargetSpec)
    (fuel : Nat) (id : Nat) (sig : memberOf cyc id = false) (m1 mem : ConcreteMem) (σ σ1 : State)
    (hr : Word.runBlockSt w id spec mem σ = (m1, Block.End.ret σ1)) :
    Word.enterCycle w cyc spec (fuel + 1) mem id σ = none := by
  simp [Word.enterCycle, sig]
  cases hd : Word.runBlockSt w id spec mem σ with
  | mk mem' end' =>
      cases end' with
      | ret σ' =>
          rfl
      | go u σ' =>
          exfalso
          cases congrArg Prod.snd (by
            calc (m1, Block.End.ret σ1) = Word.runBlockSt w id spec mem σ := by rw [← hr]
                 _ = (mem', Block.End.go u σ') := hd)
      | brIf u v d σ' =>
          exfalso
          cases congrArg Prod.snd (by
            calc (m1, Block.End.ret σ1) = Word.runBlockSt w id spec mem σ := by rw [← hr]
                 _ = (mem', Block.End.brIf u v d σ') := hd)
      | trap =>
          exfalso
          cases congrArg Prod.snd (by
            calc (m1, Block.End.ret σ1) = Word.runBlockSt w id spec mem σ := by rw [← hr]
                 _ = (mem', Block.End.trap) := hd)

private theorem enterCycle_go_aux (w : Word) (cyc : Cycle) (spec : Tyu.IR.TargetSpec)
    (fuel : Nat) (id t : Nat) (sig : memberOf cyc id = false) (ht : memberOf cyc t = true)
    (m1 mem : ConcreteMem) (σ σ1 : State)
    (hr : Word.runBlockSt w id spec mem σ = (m1, Block.End.go t σ1)) :
    Word.enterCycle w cyc spec (fuel + 1) mem id σ = some (t, fuel, σ1) := by
  simp [Word.enterCycle, sig]
  cases hd : Word.runBlockSt w id spec mem σ with
  | mk mem' end' =>
      cases end' with
      | ret σ' =>
          exfalso
          cases congrArg Prod.snd (by
            calc (m1, Block.End.go t σ1) = Word.runBlockSt w id spec mem σ := by rw [← hr]
                 _ = (mem', Block.End.ret σ') := hd)
      | go u σ' =>
          have hEq : (m1, Block.End.go t σ1) = (mem', Block.End.go u σ') := by
            calc
              (m1, Block.End.go t σ1) = Word.runBlockSt w id spec mem σ := by rw [← hr]
              _ = (mem', Block.End.go u σ') := hd
          have hbr := Block.End.go.inj (congrArg Prod.snd hEq)
          rcases hbr with ⟨hu, hs⟩
          rw [show (match (mem', Block.End.go u σ') with
                      | (mem2, Block.End.ret st1) => none
                      | (mem2, Block.End.go t st1) => Word.enterCycle w cyc spec fuel mem2 t st1
                      | (mem2, Block.End.brIf t e cond st1) =>
                          if cond ≠ 0 then Word.enterCycle w cyc spec fuel mem2 t st1 else Word.enterCycle w cyc spec fuel mem2 e st1
                      | (mem2, Block.End.trap) => none) = Word.enterCycle w cyc spec fuel mem' u σ' by rfl]
          have hut : memberOf cyc u = true := by simpa [hu] using ht
          unfold Word.enterCycle
          simp [hut, hu, hs]
      | brIf a b c σ' =>
          exfalso
          cases congrArg Prod.snd (by
            calc (m1, Block.End.go t σ1) = Word.runBlockSt w id spec mem σ := by rw [← hr]
                 _ = (mem', Block.End.brIf a b c σ') := hd)
      | trap =>
          exfalso
          cases congrArg Prod.snd (by
            calc (m1, Block.End.go t σ1) = Word.runBlockSt w id spec mem σ := by rw [← hr]
                 _ = (mem', Block.End.trap) := hd)

private theorem enterCycle_brIf_t_aux (w : Word) (cyc : Cycle) (spec : Tyu.IR.TargetSpec)
    (fuel : Nat) (id t e : Nat) (c : Value) (sig : memberOf cyc id = false) (ht : memberOf cyc t = true) (hc : c ≠ 0)
    (m1 mem : ConcreteMem) (σ σ1 : State)
    (hr : Word.runBlockSt w id spec mem σ = (m1, Block.End.brIf t e c σ1)) :
    Word.enterCycle w cyc spec (fuel + 1) mem id σ = some (t, fuel, σ1) := by
  simp [Word.enterCycle, sig]
  cases hd : Word.runBlockSt w id spec mem σ with
  | mk mem' end' =>
      cases end' with
      | ret σ' =>
          exfalso
          cases congrArg Prod.snd (by
            calc (m1, Block.End.brIf t e c σ1) = Word.runBlockSt w id spec mem σ := by rw [← hr]
                 _ = (mem', Block.End.ret σ') := hd)
      | go u σ' =>
          exfalso
          cases congrArg Prod.snd (by
            calc (m1, Block.End.brIf t e c σ1) = Word.runBlockSt w id spec mem σ := by rw [← hr]
                 _ = (mem', Block.End.go u σ') := hd)
      | brIf u v d σ' =>
          have hEq : (m1, Block.End.brIf t e c σ1) = (mem', Block.End.brIf u v d σ') := by
            calc
              (m1, Block.End.brIf t e c σ1) = Word.runBlockSt w id spec mem σ := by rw [← hr]
              _ = (mem', Block.End.brIf u v d σ') := hd
          have hbr := Block.End.brIf.inj (congrArg Prod.snd hEq)
          rcases hbr with ⟨hu, hv, hd0, hs⟩
          rw [show (match (mem', Block.End.brIf u v d σ') with
                      | (mem2, Block.End.ret st1) => none
                      | (mem2, Block.End.go t st1) => Word.enterCycle w cyc spec fuel mem2 t st1
                      | (mem2, Block.End.brIf t e cond st1) =>
                          if cond = 0 then Word.enterCycle w cyc spec fuel mem2 e st1 else Word.enterCycle w cyc spec fuel mem2 t st1
                      | (mem2, Block.End.trap) => none) =
              (if d = 0 then Word.enterCycle w cyc spec fuel mem' v σ' else Word.enterCycle w cyc spec fuel mem' u σ') by rfl]
          have hut : memberOf cyc u = true := by simpa [hu] using ht
          rw [← hd0]
          simp [hc, hu, hs]
          unfold Word.enterCycle
          simp [hut, hu, hs]
      | trap =>
          exfalso
          cases congrArg Prod.snd (by
            calc (m1, Block.End.brIf t e c σ1) = Word.runBlockSt w id spec mem σ := by rw [← hr]
                 _ = (mem', Block.End.trap) := hd)

private theorem enterCycle_brIf_e_aux (w : Word) (cyc : Cycle) (spec : Tyu.IR.TargetSpec)
    (fuel : Nat) (id t e : Nat) (c : Value) (sig : memberOf cyc id = false) (he : memberOf cyc e = true) (hc0 : c = 0)
    (m1 mem : ConcreteMem) (σ σ1 : State)
    (hr : Word.runBlockSt w id spec mem σ = (m1, Block.End.brIf t e c σ1)) :
    Word.enterCycle w cyc spec (fuel + 1) mem id σ = some (e, fuel, σ1) := by
  simp [Word.enterCycle, sig]
  cases hd : Word.runBlockSt w id spec mem σ with
  | mk mem' end' =>
      cases end' with
      | ret σ' =>
          exfalso
          cases congrArg Prod.snd (by
            calc (m1, Block.End.brIf t e c σ1) = Word.runBlockSt w id spec mem σ := by rw [← hr]
                 _ = (mem', Block.End.ret σ') := hd)
      | go u σ' =>
          exfalso
          cases congrArg Prod.snd (by
            calc (m1, Block.End.brIf t e c σ1) = Word.runBlockSt w id spec mem σ := by rw [← hr]
                 _ = (mem', Block.End.go u σ') := hd)
      | brIf u v d σ' =>
          have hEq : (m1, Block.End.brIf t e c σ1) = (mem', Block.End.brIf u v d σ') := by
            calc
              (m1, Block.End.brIf t e c σ1) = Word.runBlockSt w id spec mem σ := by rw [← hr]
              _ = (mem', Block.End.brIf u v d σ') := hd
          have hbr := Block.End.brIf.inj (congrArg Prod.snd hEq)
          rcases hbr with ⟨hu, hv, hd0, hs⟩
          rw [show (match (mem', Block.End.brIf u v d σ') with
                      | (mem2, Block.End.ret st1) => none
                      | (mem2, Block.End.go t st1) => Word.enterCycle w cyc spec fuel mem2 t st1
                      | (mem2, Block.End.brIf t e cond st1) =>
                          if cond = 0 then Word.enterCycle w cyc spec fuel mem2 e st1 else Word.enterCycle w cyc spec fuel mem2 t st1
                      | (mem2, Block.End.trap) => none) =
              (if d = 0 then Word.enterCycle w cyc spec fuel mem' v σ' else Word.enterCycle w cyc spec fuel mem' u σ') by rfl]
          have hev : memberOf cyc v = true := by simpa [hv] using he
          rw [← hd0]
          simp [hc0, hv, hs]
          unfold Word.enterCycle
          simp [hev]
      | trap =>
          exfalso
          cases congrArg Prod.snd (by
            calc (m1, Block.End.brIf t e c σ1) = Word.runBlockSt w id spec mem σ := by rw [← hr]
                 _ = (mem', Block.End.trap) := hd)

private theorem enterCycle_trap_aux (w : Word) (cyc : Cycle) (spec : Tyu.IR.TargetSpec)
    (fuel : Nat) (id : Nat) (sig : memberOf cyc id = false) (m1 mem : ConcreteMem) (σ : State)
    (hr : Word.runBlockSt w id spec mem σ = (m1, Block.End.trap)) :
    Word.enterCycle w cyc spec (fuel + 1) mem id σ = none := by
  simp [Word.enterCycle, sig]
  cases hd : Word.runBlockSt w id spec mem σ with
  | mk mem' end' =>
      cases end' with
      | ret σ' =>
          exfalso
          cases congrArg Prod.snd (by
            calc (m1, Block.End.trap) = Word.runBlockSt w id spec mem σ := by rw [← hr]
                 _ = (mem', Block.End.ret σ') := hd)
      | go u σ' =>
          exfalso
          cases congrArg Prod.snd (by
            calc (m1, Block.End.trap) = Word.runBlockSt w id spec mem σ := by rw [← hr]
                 _ = (mem', Block.End.go u σ') := hd)
      | brIf a b c σ' =>
          exfalso
          cases congrArg Prod.snd (by
            calc (m1, Block.End.trap) = Word.runBlockSt w id spec mem σ := by rw [← hr]
                 _ = (mem', Block.End.brIf a b c σ') := hd)
      | trap =>
          rfl

theorem Word.enterCycle_ret (w : Word) (cyc : Cycle) (spec : Tyu.IR.TargetSpec)
    (fuel : Nat) (id : Nat) (sig : memberOf cyc id = false) (m1 mem : ConcreteMem) (σ σ1 : State)
    (hr : Word.runBlockSt w id spec mem σ = (m1, Block.End.ret σ1)) :
    Word.enterCycle w cyc spec (fuel + 1) mem id σ = none :=
  enterCycle_ret_aux w cyc spec fuel id sig m1 mem σ σ1 hr

theorem Word.enterCycle_go (w : Word) (cyc : Cycle) (spec : Tyu.IR.TargetSpec)
    (fuel : Nat) (id t : Nat) (sig : memberOf cyc id = false) (ht : memberOf cyc t = true)
    (m1 mem : ConcreteMem) (σ σ1 : State)
    (hr : Word.runBlockSt w id spec mem σ = (m1, Block.End.go t σ1)) :
    Word.enterCycle w cyc spec (fuel + 1) mem id σ = some (t, fuel, σ1) :=
  enterCycle_go_aux w cyc spec fuel id t sig ht m1 mem σ σ1 hr

theorem Word.enterCycle_brIf_t (w : Word) (cyc : Cycle) (spec : Tyu.IR.TargetSpec)
    (fuel : Nat) (id t e : Nat) (c : Value) (sig : memberOf cyc id = false) (ht : memberOf cyc t = true) (hc : c ≠ 0)
    (m1 mem : ConcreteMem) (σ σ1 : State)
    (hr : Word.runBlockSt w id spec mem σ = (m1, Block.End.brIf t e c σ1)) :
    Word.enterCycle w cyc spec (fuel + 1) mem id σ = some (t, fuel, σ1) :=
  enterCycle_brIf_t_aux w cyc spec fuel id t e c sig ht hc m1 mem σ σ1 hr

theorem Word.enterCycle_brIf_e (w : Word) (cyc : Cycle) (spec : Tyu.IR.TargetSpec)
    (fuel : Nat) (id t e : Nat) (c : Value) (sig : memberOf cyc id = false) (he : memberOf cyc e = true) (hc0 : c = 0)
    (m1 mem : ConcreteMem) (σ σ1 : State)
    (hr : Word.runBlockSt w id spec mem σ = (m1, Block.End.brIf t e c σ1)) :
    Word.enterCycle w cyc spec (fuel + 1) mem id σ = some (e, fuel, σ1) :=
  enterCycle_brIf_e_aux w cyc spec fuel id t e c sig he hc0 m1 mem σ σ1 hr

theorem Word.enterCycle_trap (w : Word) (cyc : Cycle) (spec : Tyu.IR.TargetSpec)
    (fuel : Nat) (id : Nat) (sig : memberOf cyc id = false) (m1 mem : ConcreteMem) (σ : State)
    (hr : Word.runBlockSt w id spec mem σ = (m1, Block.End.trap)) :
    Word.enterCycle w cyc spec (fuel + 1) mem id σ = none :=
  enterCycle_trap_aux w cyc spec fuel id sig m1 mem σ hr

/-- A member block b routes to a member block t in one block-step, carrying
the routing-guard facts (the state σ' after the block, and — for a `br_if` —
which condition value decided the target). The developer's per-cycle
invariant law (the *cycle-lemma scheme* of §Q9) is proved against these
facts by unfolding the concrete blocks. -/
inductive StepTo (w : Word) (cyc : Cycle) (spec : Tyu.IR.TargetSpec)
    (mem : ConcreteMem) : Nat → Nat → State → State → Prop where
  | go {b t σ σ'} : Member cyc b → Member cyc t →
      (Word.runBlockSt w b spec mem σ).2 = .go t σ' → StepTo w cyc spec mem b t σ σ'
  | ifT {b t e σ σ' c} : Member cyc b → Member cyc t →
      (Word.runBlockSt w b spec mem σ).2 = .brIf t e c σ' → c ≠ 0 → StepTo w cyc spec mem b t σ σ'
  | ifF {b t e σ σ' c} : Member cyc b → Member cyc t →
      (Word.runBlockSt w b spec mem σ).2 = .brIf e t c σ' → c = 0 → StepTo w cyc spec mem b t σ σ'

/-- A member block b routes OUT of the cycle to a non-member block s in one
block-step, with the guard facts. The continuation from (s, σs) is what the
composition's LEAVE hypothesis covers. -/
inductive StepOut (w : Word) (cyc : Cycle) (spec : Tyu.IR.TargetSpec)
    (mem : ConcreteMem) : Nat → Nat → State → State → Prop where
  | go {b s σ σs} : Member cyc b → ¬ Member cyc s →
      (Word.runBlockSt w b spec mem σ).2 = .go s σs → StepOut w cyc spec mem b s σ σs
  | ifT {b s e σ σs c} : Member cyc b → ¬ Member cyc s →
      (Word.runBlockSt w b spec mem σ).2 = .brIf s e c σs → c ≠ 0 → StepOut w cyc spec mem b s σ σs
  | ifF {b s e σ σs c} : Member cyc b → ¬ Member cyc s →
      (Word.runBlockSt w b spec mem σ).2 = .brIf e s c σs → c = 0 → StepOut w cyc spec mem b s σ σs

/-- The invariant-based composition (P5.2, `stmt_…_via_cycles`): a word's
out-range claim follows from an invariant `Inv` that (ENTRY) holds wherever
a run enters the cycle, (STEP) is preserved by every member-to-member step
(pointed with the routing guards — this is the developer's per-cycle
lemma, instantiated from the scheme), (LEAVE) any member step that routes
out of the cycle runs (from the exit successor, for every remaining budget
and memory) to an in-range i-th output, (ENDED) any `ret` inside the cycle
terminates in range, and (NOENTER) every run that never reaches the cycle
terminates in range. The hypotheses quantify over every memory (the
authoritative semantics threads memory through every block step) and every
fuel budget, so the composition is uniform; the *conclusion* is stated for
the rendered instance's `mem`. -/
def ViaCycle (w : Word) (cyc : Cycle) (spec : Tyu.IR.TargetSpec)
    (mem : ConcreteMem) (i : Nat) (lo hi : Int) : Prop :=
  ∀ (Inv : State → Prop),
    (∀ (fuel : Nat) (m : ConcreteMem) (id b : Nat) (σ₀ σe : State) (rem : Nat),
        Word.enterCycle w cyc spec fuel m id σ₀ = some (b, rem, σe) → Inv σe) →
    (∀ (m : ConcreteMem) (b t : Nat) (σ σ' : State),
        Member cyc b → Member cyc t → Inv σ → StepTo w cyc spec m b t σ σ' → Inv σ') →
    (∀ (m : ConcreteMem) (b s : Nat) (σ σs : State),
        Member cyc b → ¬ Member cyc s → Inv σ → StepOut w cyc spec m b s σ σs →
          ∀ (fuel : Nat) (m2 : ConcreteMem) (σf : State),
            Word.runFrom w s spec fuel m2 σs = some σf → outRangeAt i lo hi σf) →
    (∀ (b : Nat) (fuel : Nat) (m : ConcreteMem) (σ σe : State),
        Member cyc b → Inv σ → (Word.runBlockSt w b spec m σ).2 = .ret σe →
          outRangeAt i lo hi σe) →
    (∀ (fuel : Nat) (m : ConcreteMem) (id : Nat) (σ₀ σf : State),
        Word.enterCycle w cyc spec fuel m id σ₀ = none →
          Word.runFrom w id spec fuel m σ₀ = some σf → outRangeAt i lo hi σf) →
    ∀ (fuel : Nat) (σ₀ σf : State),
      Word.runFrom w w.entry spec fuel mem σ₀ = some σf → outRangeAt i lo hi σf

-- the rendered via-cycles statement quantifies the whole (TargetSpec, Mem)
-- surface, exactly as the word statements do (§Q3)
def ViaCycles (w : Word) (cyc : Cycle) (i : Nat) (lo hi : Int) : Prop :=
  ∀ (spec : Tyu.IR.TargetSpec) (mem : ConcreteMem),
    ViaCycle w cyc spec mem i lo hi

/-- The soundness of [`ViaCycle`]: the composition is a *theorem*, not a
marker. Proved by well-founded induction on the run's fuel budget, with the
routing-guard facts carried through the [`StepTo`]/[`StepOut`] witnesses and
the memory threaded exactly as `Tyu.Step.runWord` threads it (the
continuation memory after every block step). -/
theorem via_cycle_sound (w : Word) (cyc : Cycle) (spec : Tyu.IR.TargetSpec)
    (mem : ConcreteMem) (i : Nat) (lo hi : Int) : ViaCycle w cyc spec mem i lo hi := by
  unfold ViaCycle
  intro Inv hEntry hStep hLeave hEnded hNoEnter
  -- the per-budget strong claim: every run from any block is in range; the
  -- premise `Member cyc id → Inv σ` carries the invariant into member blocks
  have strong : ∀ (fuel : Nat) (m : ConcreteMem) (id : Nat) (σ σf : State),
      Word.runFrom w id spec fuel m σ = some σf → (Member cyc id → Inv σ) →
        outRangeAt i lo hi σf := by
    intro fuel
    induction fuel with
    | zero =>
        intro m id σ σf h _
        simp [Word.runFrom] at h
    | succ fuel' ih =>
        intro m id σ σf h hminv
        cases hid : memberOf cyc id with
        | false =>
            -- a non-member block: terminate (NOENTER), keep going outside
            -- (recursion), or enter the cycle (ENTRY)
            cases hd : Word.runBlockSt w id spec m σ with
            | mk mem1 rout =>
                cases rout with
                | ret σ1 =>
                    have hrn : Word.runFrom w id spec (fuel' + 1) m σ = some σ1 :=
                      Word.runFrom_ret w id spec fuel' mem1 m σ σ1 hd
                    have hnoenter : outRangeAt i lo hi σ1 :=
                      hNoEnter (fuel' + 1) m id σ σ1
                        (Word.enterCycle_ret w cyc spec fuel' id hid mem1 m σ σ1 hd)
                        hrn
                    have hσf : σf = σ1 := by
                      rw [hrn] at h
                      exact Option.some.inj h.symm
                    simpa [hσf] using hnoenter
                | go t σ1 =>
                    have hcont : Word.runFrom w t spec fuel' mem1 σ1 = some σf := by
                      rw [Word.runFrom_go w id t spec fuel' mem1 m σ σ1 hd] at h
                      exact h
                    cases ht : memberOf cyc t with
                    | true =>
                        -- first entry into the cycle: ENTRY gives the invariant
                        have hE : Inv σ1 :=
                          hEntry (fuel' + 1) m id t σ σ1 fuel'
                            (Word.enterCycle_go w cyc spec fuel' id t hid ht mem1 m σ σ1 hd)
                        exact ih mem1 t σ1 σf hcont (fun _ => hE)
                    | false =>
                        have hne : ¬ Member cyc t := by simpa [Member] using ht
                        exact ih mem1 t σ1 σf hcont (fun hm => False.elim (hne hm))
                | brIf t e cond σ1 =>
                    have hru0 : Word.runFrom w id spec (fuel' + 1) m σ =
                        (if cond ≠ 0 then Word.runFrom w t spec fuel' mem1 σ1 else Word.runFrom w e spec fuel' mem1 σ1) :=
                      Word.runFrom_brIf w id t e spec fuel' cond mem1 m σ σ1 hd
                    rw [hru0] at h
                    by_cases hc : cond ≠ 0
                    · have hru' : Word.runFrom w t spec fuel' mem1 σ1 = some σf := by
                        simpa [hc] using h
                      cases ht : memberOf cyc t with
                      | true =>
                          have hE : Inv σ1 :=
                            hEntry (fuel' + 1) m id t σ σ1 fuel'
                              (Word.enterCycle_brIf_t w cyc spec fuel' id t e cond hid ht hc mem1 m σ σ1 hd)
                          exact ih mem1 t σ1 σf hru' (fun _ => hE)
                      | false =>
                          have hne : ¬ Member cyc t := by simpa [Member] using ht
                          exact ih mem1 t σ1 σf hru' (fun hm => False.elim (hne hm))
                    · have hc0 : cond = 0 := Classical.byContradiction (fun hneq => hc hneq)
                      have hru'' : Word.runFrom w e spec fuel' mem1 σ1 = some σf := by
                        simpa [hc0] using h
                      cases he : memberOf cyc e with
                      | true =>
                          have hE : Inv σ1 :=
                            hEntry (fuel' + 1) m id e σ σ1 fuel'
                              (Word.enterCycle_brIf_e w cyc spec fuel' id t e cond hid he hc0 mem1 m σ σ1 hd)
                          exact ih mem1 e σ1 σf hru'' (fun _ => hE)
                      | false =>
                          have hne : ¬ Member cyc e := by simpa [Member] using he
                          exact ih mem1 e σ1 σf hru'' (fun hm => False.elim (hne hm))
                | trap =>
                    have : none = some σf := by
                      rw [Word.runFrom_trap w id spec fuel' mem1 m σ hd] at h
                      exact h
                    contradiction
        | true =>
            -- a member block: ret (ENDED), member→member (STEP), or out
            -- (LEAVE); traps cannot terminate
            have hmem' : Member cyc id := by simpa [Member] using hid
            have hinv : Inv σ := hminv hmem'
            cases hd : Word.runBlockSt w id spec m σ with
            | mk mem1 rout =>
                cases rout with
                | ret σ1 =>
                    have hend : outRangeAt i lo hi σ1 :=
                      hEnded id (fuel' + 1) m σ σ1 hmem' hinv
                        (congrArg (fun r : ConcreteMem × Block.End => r.2) hd)
                    have hσf : σf = σ1 := by
                      rw [Word.runFrom_ret w id spec fuel' mem1 m σ σ1 hd] at h
                      exact Option.some.inj h.symm
                    simpa [hσf] using hend
                | go t σ1 =>
                    have hcont : Word.runFrom w t spec fuel' mem1 σ1 = some σf := by
                      rw [Word.runFrom_go w id t spec fuel' mem1 m σ σ1 hd] at h
                      exact h
                    cases ht : memberOf cyc t with
                    | true =>
                        -- STEP: the member step keeps the invariant
                        have hstep : Inv σ1 :=
                          hStep m id t σ σ1 hmem' (by simpa [Member] using ht) hinv
                            (StepTo.go hmem' (by simpa [Member] using ht)
                              (congrArg (fun r : ConcreteMem × Block.End => r.2) hd))
                        exact ih mem1 t σ1 σf hcont (fun _ => hstep)
                    | false =>
                        -- LEAVE: the whole continuation is covered
                        have hne : ¬ Member cyc t := by simpa [Member] using ht
                        exact hLeave m id t σ σ1 hmem' hne hinv
                          (StepOut.go hmem' hne
                            (congrArg (fun r : ConcreteMem × Block.End => r.2) hd))
                          fuel' mem1 σf hcont
                | brIf t e cond σ1 =>
                    have hru0 : Word.runFrom w id spec (fuel' + 1) m σ =
                        (if cond ≠ 0 then Word.runFrom w t spec fuel' mem1 σ1 else Word.runFrom w e spec fuel' mem1 σ1) :=
                      Word.runFrom_brIf w id t e spec fuel' cond mem1 m σ σ1 hd
                    rw [hru0] at h
                    by_cases hc : cond ≠ 0
                    · -- taken branch t
                      have hru' : Word.runFrom w t spec fuel' mem1 σ1 = some σf := by
                        simpa [hc] using h
                      cases ht : memberOf cyc t with
                      | true =>
                          have hstep : Inv σ1 :=
                            hStep m id t σ σ1 hmem' (by simpa [Member] using ht) hinv
                              (StepTo.ifT hmem' (by simpa [Member] using ht)
                                (congrArg (fun r : ConcreteMem × Block.End => r.2) hd)
                                hc)
                          exact ih mem1 t σ1 σf hru' (fun _ => hstep)
                      | false =>
                          have hne : ¬ Member cyc t := by simpa [Member] using ht
                          exact hLeave m id t σ σ1 hmem' hne hinv
                            (StepOut.ifT hmem' hne
                              (congrArg (fun r : ConcreteMem × Block.End => r.2) hd)
                              hc)
                            fuel' mem1 σf hru'
                    · have hc0 : cond = 0 := Classical.byContradiction (fun hneq => hc hneq)
                      -- taken branch e
                      have hru'' : Word.runFrom w e spec fuel' mem1 σ1 = some σf := by
                        simpa [hc0] using h
                      cases he : memberOf cyc e with
                      | true =>
                          have hstep : Inv σ1 :=
                            hStep m id e σ σ1 hmem' (by simpa [Member] using he) hinv
                              (StepTo.ifF hmem' (by simpa [Member] using he)
                                (congrArg (fun r : ConcreteMem × Block.End => r.2) hd)
                                hc0)
                          exact ih mem1 e σ1 σf hru'' (fun _ => hstep)
                      | false =>
                          have hne : ¬ Member cyc e := by simpa [Member] using he
                          exact hLeave m id e σ σ1 hmem' hne hinv
                            (StepOut.ifF hmem' hne
                              (congrArg (fun r : ConcreteMem × Block.End => r.2) hd)
                              hc0)
                            fuel' mem1 σf hru''
                | trap =>
                    have : none = some σf := by
                      rw [Word.runFrom_trap w id spec fuel' mem1 m σ hd] at h
                      exact h
                    contradiction
  -- the top-level run from the word's entry
  intro fuel σ₀ σf h
  cases he : memberOf cyc w.entry with
  | true =>
      have hE : Inv σ₀ :=
        hEntry fuel mem w.entry w.entry σ₀ σ₀ fuel (by
          cases fuel <;> simp [Word.enterCycle, he])
      exact strong fuel mem w.entry σ₀ σf h (fun _ => hE)
  | false =>
      have hne : ¬ Member cyc w.entry := by simpa [Member] using he
      exact strong fuel mem w.entry σ₀ σf h (fun hm => False.elim (hne hm))

end Tyu.Gen.Stmt